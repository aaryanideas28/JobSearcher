# File: .env.example
APP_NAME=AI Resume Automation Platform
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg2://resume_user:resume_password@localhost:5432/resume_automation
POSTGRES_DB=resume_automation
POSTGRES_USER=resume_user
POSTGRES_PASSWORD=resume_password

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_SMALL_MODEL=llama3.2:1b
OLLAMA_LARGE_MODEL=llama3.1:8b

TAVILY_API_KEY=replace-me
OPENAI_API_KEY=replace-me
GOOGLE_API_KEY=replace-me
LANGFUSE_PUBLIC_KEY=replace-me
LANGFUSE_SECRET_KEY=replace-me
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_REFRESH_TOKEN=replace-me
EMAIL_SENDER=no-reply@example.com
