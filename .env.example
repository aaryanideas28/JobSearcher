# File: .env.example
APP_NAME=AI Resume Automation Platform
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg2://resume_user:resume_password@localhost:5432/resume_automation
POSTGRES_DB=resume_automation
POSTGRES_USER=resume_user
POSTGRES_PASSWORD=resume_password

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_SMALL_MODEL=llama3.2:1b
OLLAMA_LARGE_MODEL=llama3.1:8b

TAVILY_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
EMAIL_SENDER=no-reply@example.com
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret

# SMTP Fallback Settings (Alternative to Google OAuth for sending email)
CELERY_TASK_ALWAYS_EAGER=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
